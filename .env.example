# Plain KEY=value. Loaded by Task, air, Docker Compose and `docker run --env-file`.
TELEGRAM_TOKEN=
# Your Telegram user id(s), comma-separated (ask @userinfobot)
ADMIN_IDS=

# Any OpenAI-compatible Responses API. OpenRouter:
#   OPENAI_BASE_URL=https://openrouter.ai/api/v1
#   OPENAI_MODEL=openai/gpt-5-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Zone for "today" (code expiry), the search schedule and logs.
TZ=UTC

# /start sends codes without an expiry date only if added within this many
# days (0 = all); /codes lists the older ones after the fresh ones.
FRESH_DAYS=7
